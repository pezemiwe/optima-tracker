{
  "name": "cortex-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Cortex Tracker: projects, tasks, boards and calendars for teams",
  "main": "server.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
